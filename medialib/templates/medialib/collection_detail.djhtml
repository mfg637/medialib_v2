{% extends "medialib/base.djhtml" %}
{% load url_utils %}
{% block title %}Collection: {{ collection.title }} - {{ block.super }}{% endblock %}
{% block content %}
    <style>
        .info-section-element{
            padding: 2em;
        }
        form {
            margin-bottom: 20px;
        }
        form input[name=content_id] {
            padding: 8px;
            border-radius: 4px;
            border: 1px solid var(--border-color);
            background: var(--bg-main);
            color: var(--text-main)
        }
        .items-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, 256px);
            gap: 20px;
            justify-content: center;
            padding: 20px;
            background-color: var(--bg-main);
        }
        .item-card {
            width: 256px;
            height: 256px;
            position: relative;
            overflow: hidden;
            border-radius: 8px;
            background-color: var(--bg-accent);
            border: 1px solid var(--border-color);
            transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;

            display: flex;
            align-items: center;
            justify-content: center;
        }

        .item-card:hover {
            transform: scale(1.03);
            border-color: var(--accent-color);
            box-shadow: 0 4px 12px var(--similar-item-shadow);
        }

        .item-card img {
            max-width: 100%;
            max-height: 100%;
            display: block;
            object-fit: contain;
        }
    </style>
    <div class="info-section-element">
        <h2>
            {{ collection.title }}
            {% if collection.is_nsfw %}<span style="color: var(--accent-color);">[NSFW]</span>{% endif %}
        </h2>
        <form action="{% url 'collection-toggle-nsfw' collection.pk %}"
              method="post"
              style="display:inline">
            {% csrf_token %}
            <button type="submit"
                    class="button {% if not collection.is_nsfw %}accent{% endif %}">
                Mark as
                {% if collection.is_nsfw %}
                    SFW
                {% else %}
                    NSFW
                {% endif %}
            </button>
        </form>
        <form action="{% url 'collection-add-item' collection.pk %}" method="post">
            {% csrf_token %}
            <input type="number" name="content_id" placeholder="Content ID" required>
            <button type="submit" class="button">Add by ID</button>
        </form>
        <div class="items-grid">
            {% for content_item in content_list %}
                <div class="item-card">
                    <a href="{% url 'content-info' content_item.slug %}"
                       data-slug="{{ content_item.slug }}"
                       data-name="{{ content_item.name }}"
                       data-content-type="{{ content_item.content_type }}"
                       data-index="{{ forloop.counter0 }}">
                        <img src="/{{ MEDIA_URL }}{{ content_item.base_src }}"
                             {% if content_item.srcset %}srcset="{{ content_item.srcset }}"{% endif %}
                             alt="{{ content_item.name|default:"Untitled" }}"
                             loading="lazy">
                    </a>
                </div>
            {% empty %}
                <p>Not found.</p>
            {% endfor %}
        </div>
        <hr>
        <a href="{% url 'collection-list' %}" class="button">Back to list</a>
        {% if page_obj.has_other_pages %}
            <div class="pagination">
                {% if page_obj.has_previous %}
                    <a href="?{% replace_param page=page_obj.previous_page_number %}">Previous</a>
                {% endif %}
                <span>Page {{ page_obj.number }} of {{ page_obj.paginator.num_pages }}</span>
                {% if page_obj.has_next %}
                    <a href="?{% replace_param page=page_obj.next_page_number %}">Next</a>
                {% endif %}
            </div>
        {% endif %}
        {% include "medialib/components/image-viewer.djhtml" %}
        <image-viewer-app>
    </image-viewer-app>
</div>
{% endblock %}
