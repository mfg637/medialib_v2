<!DOCTYPE html>
<html lang="ru">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>
            {% block title %}MediaLib v2{% endblock %}
        </title>
        <link rel="stylesheet" href="/static/css/main.css">
        <!-- fix Flash of Unstyled Content -->
        <script>
            (function() {
                const savedTheme = localStorage.getItem("ml-theme");
                console.debug("saved theme", savedTheme);
                if (savedTheme && savedTheme !== "NONE") {
                    document.documentElement.classList.add(savedTheme);
                }
            })();
        </script>
    </head>
    <body>
        <header>
            <section class="home-link-and-parameters">
                <a class="home-page-link" href="/" title="Home page">
                    <span class="nostyle-fallback">Home</span>
                </a>
                {% include "medialib/components/theme_selector.djhtml" %}
                {% include "medialib/components/cl_selector.djhtml" %}
            </section>
            <section class="login-indication">
                {% if user.is_authenticated %}
                    <span class="user-info">
                        <strong>{{ user.username }}</strong>
                    </span>
                    <form action="{% url 'logout' %}" method="post">
                        {% csrf_token %}
                        <button type="submit" class="logout-button">Logout</button>
                    </form>
                {% else %}
                    <a href="{% url 'login' %}" class="login-link">Login</a>
                {% endif %}
            </section>
        </header>
        <main>
            {% block content %}{% endblock %}
        </main>
    </body>
</html>
