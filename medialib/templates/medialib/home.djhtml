{% extends "medialib/base.djhtml" %}
{% block content %}
    <style>
    .home-container {
        text-align: center;
        padding-top: 50px;
    }

    .main-menu {
        display: flex;
        flex-direction: column;
        justify-content: center;
        list-style: none;
        padding: 0;
        margin: 40px 0;
        gap: 15px;
    }

    .main-menu li {
        margin: 0 auto;
        width: 100%;
        max-width: 300px;
        display: flex;
    }

    .main-menu a {
        flex: 1;
        text-align: center;
        text-decoration: none;
        font-size: 1.2rem;
        color: var(--accent-color); 
        font-weight: bold;
        padding: 12px 24px;
        border: 2px solid var(--accent-color);
        border-radius: 8px;
        background-color: transparent;
        transition: background-color 0.2s, color 0.2s, transform 0.1s;
    }

    .main-menu a:hover {
        background-color: var(--accent-color);
        color: var(--text-on-accent);
        transform: translateY(-2px);
    }

    .main-menu a:active {
        transform: translateY(0);
    }
    </style>
    <div class="home-container">
        <h1>Home Page</h1>
        <nav>
            <menu class="main-menu">
                <li>
                    <a href="{% url 'content-list' %}">Gallery</a>
                </li>
                <li>
                    <a href="{% url 'collection-list' %}">Collections</a>
                </li>
                <li>
                    <a href="{% url 'album-list' %}">Albums</a>
                </li>
            </menu>
        </nav>
        <section class="portrait-specific">
            <h2>Configuration</h2>
            <div class="field-wrapper">
                <theme-selector></theme-selector>
            </div>
            <div class="field-wrapper">
                <cl-selector current="{{ CURRENT_CL }}"></cl-selector>
            </div>
        </section>
    </div>
{% endblock %}
