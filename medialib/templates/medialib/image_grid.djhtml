{% extends "medialib/base.djhtml" %}
{% block title %}Gallery - {{ block.super }}{% endblock %}
{% block content %}
    <style>
    .items-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, 256px);
        gap: 16px;
        justify-content: center;
        padding: 20px;
    }

    .item-card {
        width: 256px;
        height: 256px;
        position: relative;
        overflow: hidden;
        border-radius: 4px;
        background-color: #f0f0f0;
        transition: transform 0.2s;

        display: flex;
        align-items: center;
        justify-content: center;
    }

    .item-card:hover {
        transform: scale(1.02);
    }

    .item-card img {
        max-width: 100%;
        max-height: 100%;
        display: block;
    }

    .search-container {
        padding: 20px;
        background: #fafafa;
        border-bottom: 1px solid #eee;
    }

    .search-container .main-field{
        text-align: center;
    }

    .search-input {
        width: 60%;
        padding: 10px;
        font-family: monospace;
    }

    .search-container button[type="submit"] {
        width: 4em;
        padding: 10px;
    }
    .search-container .additional-fields{
        width: calc(60% + 4em + 20px);
        margin: 0 auto;
    }

    .pagination {
        margin: 30px 0;
        text-align: center;
    }
    .pagination a, .pagination span {
        padding: 8px 16px;
        text-decoration: none;
        border: 1px solid #ccc;
        color: #333;
        margin: 0 4px;
    }
    </style>
    <div class="search-container">
        <form method="GET" action="{% url 'content-list' %}">
            <div class="main-field">
                <input type="text"
                       name="q"
                       class="search-input"
                       placeholder="Type search query"
                       value="{{ query_string|default:'' }}">
                <button type="submit">Find</button>
            </div>
            <div class="additional-fields">
                <label>
                    Filter:
                    <select name="filter">
                        {% for f in available_filters %}
                            <option value="{{ f }}" {% if filter_name == f %}selected{% endif %}>{{ f }}</option>
                        {% endfor %}
                    </select>
                </label>
            </div>
        </form>
    </div>
    <div class="items-grid">
        {% for content_item in content_list %}
            <div class="item-card">
                <a href="{% url 'content-info' content_item.slug %}">
                    <img src="{% url 'content-representation' content_item.slug %}?side_size=256"
                         {% if content_item.srcset %}srcset="{{ content_item.srcset }}"{% endif %}
                         alt="{{ content_item.name|default:"Untitled" }}"
                         loading="lazy">
                </a>
            </div>
        {% empty %}
            <p>Not found.</p>
        {% endfor %}
    </div>
    {% if page_obj.has_other_pages %}
        <div class="pagination">
            {% if page_obj.has_previous %}
                <a href="?q={{ query_string|urlencode }}&page={{ page_obj.next_page_number }}&per_page={{ per_page }}&filter={{ filter_name }}">Previous</a>
            {% endif %}
            <span>Page {{ page_obj.number }} of {{ page_obj.paginator.num_pages }}</span>
            {% if page_obj.has_next %}
                <a href="?q={{ query_string|urlencode }}&page={{ page_obj.next_page_number }}&per_page={{ per_page }}&filter={{ filter_name }}">Next</a>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
