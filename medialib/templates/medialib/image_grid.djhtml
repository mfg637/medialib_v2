{% extends "medialib/base.djhtml" %}
{% load url_utils %}
{% block title %}Gallery - {{ block.super }}{% endblock %}
{% block content %}
    <style>
    .search-container {
        padding: 24px;
        background-color: var(--bg-accent);
        border-bottom: 1px solid var(--border-color);
    }

    .search-container .main-field {
        text-align: center;
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    .search-input {
        width: 60%;
        padding: 10px 15px;
        font-family: var(--font-mono, monospace);
        background-color: var(--bg-header-item, var(--bg-main));
        color: var(--text-input, var(--text-main));;
        border: 1px solid var(--border-header-item, var(--border-color));
        border-radius: 6px;
    }

    .search-container button[type="submit"] {
        padding: 10px 20px;
        background-color: var(--accent-color);
        color: var(--text-on-accent);
        border: 1px solid var(--accent-hover);
        border-radius: 6px;
        font-weight: bold;
        transition: background-color 0.2s, transform 0.1s;
    }

    .search-container button[type="submit"]:hover {
      background-color: var(--accent-hover);
      transform: translateY(-1px);
    }
    
    .search-container button[type="submit"]:active {
      transform: translateY(0);
    }

    .search-container .additional-fields {
        width: calc(60% + 4em + 40px);
        margin: 1rem auto 0;
        color: var(--text-muted);
    }

    .search-container .additional-fields select,
    .search-container .additional-fields input {
        background-color: var(--bg-header-item, var(--bg-main));
        border-color: var(--border-header-item, var(--border-color));
    }

    @media (max-width: 689px) {
        .search-container .additional-fields {
            width: 95%;
            margin: 1.5rem auto 0;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
    
        .search-container .additional-fields label {
            display: flex;
            flex-direction: column;
            gap: 5px;
            font-size: 0.9rem;
            width: 100%;
        }
    
        .search-container .additional-fields select,
        .search-container .additional-fields input#per-page-input {
            width: 100%;
            box-sizing: border-box;
            padding: 10px;
            font-size: 1rem;
            height: 44px;
        }
    
        .search-container .main-field {
            display: flex;
            flex-direction: row;
            width: 95%;
            margin: 0 auto;
        }
    
        .search-container .main-field .search-input {
            flex: 1;
        }
    }
    </style>
    <link rel="stylesheet" href="/static/css/image-grid.css">
    <div class="search-container">
        <form method="get" action="{% url 'content-list' %}">
            <div class="main-field">
                <input type="text"
                       name="q"
                       class="search-input"
                       placeholder="Type search query"
                       value="{{ query_string|default:'' }}">
                <button type="submit">Find</button>
            </div>
            <div class="additional-fields">
                <label>
                    Filter:
                    <select name="filter">
                        {% for f in available_filters %}
                            <option value="{{ f }}" {% if filter_name == f %}selected{% endif %}>{{ f }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label>
                    Order by:
                    <select name="sort">
                        {% for f in sorting_modes_available %}
                            <option value="{{ f }}" {% if sorting_mode == f %}selected{% endif %}>{{ f }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label>
                    Items:
                    <input id="per-page-input"
                           type="number"
                           name="per_page"
                           value="{{ per_page }}"
                           min="3"
                           max="50" />
                </label>
                <script>
                    document.addEventListener('DOMContentLoaded', () => {
                        const perPageInput = document.getElementById('per-page-input');
                        
                        if ('loading' in HTMLImageElement.prototype) {
                            perPageInput.max = 1000;
                            perPageInput.title = "Lazy loading supported: you can load up to 1000 items";
                        }
                    });
                </script>
            </div>
        </form>
    </div>
    <div class="items-grid" id="items-grid">
        {% for content_item in content_list %}
            <div class="item-card">
                <a href="{% url 'content-info' content_item.slug %}"
                   data-slug="{{ content_item.slug }}"
                   data-name="{{ content_item.name }}"
                   data-content-type="{{ content_item.content_type }}"
                   data-index="{{ forloop.counter0 }}">
                    <img src="/{{ MEDIA_URL }}{{ content_item.base_src }}"
                         {% if content_item.srcset %}srcset="{{ content_item.srcset }}"{% endif %}
                         alt="{{ content_item.name|default:"Untitled" }}"
                         loading="lazy">
                </a>
            </div>
        {% empty %}
            <p>Not found.</p>
        {% endfor %}
    </div>
    {% include "medialib/components/image-viewer.djhtml" %}
    <image-viewer-app>
</image-viewer-app>
{% endblock %}
