{% extends "medialib/base.djhtml" %}
{% block title %}{{ content.title|default:"Untitled" }} - MediaLib v2{% endblock %}
{% block content %}
    <style>
        img.main-content-image, video.main-content-video {
            max-height:95vh;
        }
    </style>
    <article class="content-page">
        <section class="viewer-section">
            <div class="media-container">
                {% with c_type=content.content_type %}
                    {% if video_representations %}
                        <video class="main-content-video"
                               {% if c_type == "video-loop" %}autoplay loop muted playsinline{% else %}controls{% endif %}
                               poster="/{{ MEDIA_URL }}{{ base_src }}">
                            {% for repr in video_representations %}
                                <source src="/{{ MEDIA_URL }}{{ repr.filepath }}"
                                        type="{{ repr.get_mime_type }}; {{ repr.codec_string }}">
                            {% endfor %}
                            Your browser does not support the video tag.
                        </video>
                    {% elif c_type == "audio" %}
                        <div class="audio-wrapper">
                            <audio controls src="/{{ MEDIA_URL }}{{ base_src }}">
                                Your browser does not support the audio element.
                            </audio>
                        </div>
                    {% elif c_type == "image" or has_image %}
                        <img src="/{{ MEDIA_URL }}{{ base_src }}"
                             {% if srcset %}srcset="{{ srcset }}"{% endif %}
                             alt="{{ content.title }}"
                             class="main-content-image">
                    {% else %}
                        <div class="no-content">No representation available</div>
                    {% endif %}
                {% endwith %}
            </div>
        </section>
        <section class="info-section">
            <header class="content-header">
                <h1>{{ content.title|default:"Untitled" }}</h1>
            </header>
            {% if content.description %}<div class="description">{{ content.description|linebreaks }}</div>{% endif %}
            <section class="origin-section">
                <h3>Sources</h3>
                <ul class="origin-list">
                    {% for origin_item in content.origin_set.all %}
                        <li class="origin-item {% if origin_item.alternate %}alternate{% endif %}">
                            {% with origin_url=origin_item.get_url_if_possible %}
                                {% if origin_url %}
                                    <a href="{{ origin_url }}"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="origin-link">
                                        <strong>{{ origin_item.name }}</strong>: <code>{{ origin_item.origin_id }}</code>
                                    </a>
                                {% else %}
                                    <strong>{{ origin_item.name }}</strong>:
                                    {% if origin_item.origin_id %}
                                        <code>{{ origin_item.origin_id }}</code>
                                    {% else %}
                                        <em>No ID</em>
                                    {% endif %}
                                {% endif %}
                            {% endwith %}
                            {% if origin_item.alternate %}<span class="badge">Alternate</span>{% endif %}
                        </li>
                    {% empty %}
                        <li>No origin information available.</li>
                    {% endfor %}
                </ul>
            </section>
            <aside class="tags-sidebar">
                <h3>Metadata</h3>
                {% for category_name, tags in grouped_tags.items %}
                    <div class="tag-group">
                        <h4 class="category-title">{{ category_name }}</h4>
                        <ul class="tag-list">
                            {% for tag_id, tag_title in tags %}
                                <li>
                                    <a href="/medialib/tag/id{{ tag_id }}" class="tag-link">{{ tag_title }}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% empty %}
                    <p class="no-tags">No tags assigned.</p>
                {% endfor %}
            </aside>
            <footer class="technical-info">
                <code>SHA-256: {{ content.source_hash.hex }}</code>
                <time datetime="{{ content.addition_date|date:'Y-m-d' }}">
                    Added: {{ content.addition_date|date:"d E Y" }}
                </time>
            </footer>
        </section>
    </article>
    {% if similar_content %}
        <section class="similar-content-section">
            <hr>
            <h3>Similar Images</h3>
            <div class="similar-grid">
                {% for item in similar_content %}
                    <a href="{% url 'content-info' item.slug %}" class="similar-item">
                        <img src="/{{ MEDIA_URL }}{{ item.base_src }}"
                             srcset="{{ item.srcset }}"
                             alt="{{ item.name }}"
                             loading="lazy"
                             class="similar-thumb">
                    </a>
                {% endfor %}
            </div>
        </section>
    {% endif %}
{% endblock %}
