{% extends "medialib/base.djhtml" %}
{% load markdown_extras %}
{% block title %}{{ content.title|default:"Untitled" }} - MediaLib v2{% endblock %}
{% block content %}
    <style>
    .content-page {
        display: flex;
        flex-wrap: wrap;
        gap: 24px;
        padding: 20px;
        max-width: 1600px;
        margin: 0 auto;
    }

    .viewer-section {
        flex: 2 1 600px;
        display: flex;
        flex-direction: column;
        align-items: center;
        background-color: var(--bg-accent);
        border-radius: 12px;
        padding: 10px;
        border: 1px solid var(--border-color);
    }

    .media-container {
        width: 100%;
        display: flex;
        justify-content: center;
    }

    img.main-content-image, 
    video.main-content-video {
        max-width: 100%;
        max-height: 85vh;
        border-radius: 4px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }

    .info-section {
        flex: 1 1 350px;
        display: flex;
        flex-direction: column;
        gap: 20px;
        min-width: 0;
    }

    .content-header h1 {
        margin: 0 0 10px 0;
        font-size: 1.8rem;
        color: var(--accent-color);
        inline-size: 100%;
        overflow-wrap: break-word;
        word-break: break-all;
    }

    .description {
        line-height: 1.6;
        color: var(--text-main);
        background: var(--bg-accent);
        padding: 15px;
        border-radius: 8px;
        border-left: 4px solid var(--accent-color);
        overflow-wrap: anywhere;
    }

    .description img{
        max-width: 100%;
        height: auto;
        border-radius: 4px;
    }

    .description p {
        margin-bottom: 1em;
    }

    .description code {
        background: var(--bg-input);
        color: var(--text-input, var(--text-main));
        padding: 2px 4px;
        border-radius: 4px;
        font-family: monospace;
    }
    
    .description ul, .description ol {
        padding-left: 1.5em;
        margin-bottom: 1em;
    }

    .info-section-element {
        background: var(--bg-accent);
        padding: 20px;
        border-radius: 8px;
        border: 1px solid var(--border-color);
    }

    .origin-section h3, .tags-sidebar h3 {
        margin-top: 0;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 10px;
        font-size: 1.2rem;
    }

    .origin-list, .tag-list {
        list-style: none;
        padding: 0;
        margin: 10px 0 0 0;
    }

    .origin-item {
        margin-bottom: 8px;
        font-size: 0.95rem;
    }

    .tag-group { margin-bottom: 15px; }
    .category-title { 
        font-size: 0.8rem; 
        text-transform: uppercase; 
        color: var(--text-muted);
        margin-bottom: 5px;
    }

    .technical-info {
        margin-top: auto;
        padding: 15px;
        font-size: 0.8rem;
        color: var(--text-muted);
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .technical-info code {
        display: block;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;
        cursor: help;
    }

    .similar-content-section {
        width: 100%;
        margin-top: 3rem;
        padding: 20px;
        border-top: 2px solid var(--border-color);
    }

    .similar-grid {
        display: flex;
        overflow-x: auto;
        gap: 16px;
        padding: 15px 5px;
        scrollbar-width: thin;
        scrollbar-color: var(--accent-color) transparent;
    }

    .similar-item {
        flex: 0 0 auto;
        width: 160px;
        height: 160px;
        border-radius: 8px;
        overflow: hidden;
        border: 2px solid transparent;
        transition: transform 0.2s, border-color 0.2s;
    }

    .similar-item:hover {
        border-color: var(--accent-color);
        transform: translateY(-5px);
    }

    .similar-thumb {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    </style>
    <article class="content-page">
        <section class="viewer-section">
            <div class="media-container">
                {% with c_type=content.content_type %}
                    {% if video_representations %}
                        <video class="main-content-video"
                               {% if c_type == "video-loop" %}autoplay loop muted playsinline{% else %}controls{% endif %}
                               poster="/{{ MEDIA_URL }}{{ base_src }}">
                            {% for repr in video_representations %}
                                <source src="/{{ MEDIA_URL }}{{ repr.filepath }}"
                                        type="{{ repr.get_mime_type }}; {{ repr.codec_string }}">
                            {% endfor %}
                            Your browser does not support the video tag.
                        </video>
                    {% elif c_type == "audio" %}
                        <div class="audio-wrapper">
                            <audio controls src="/{{ MEDIA_URL }}{{ base_src }}">
                                Your browser does not support the audio element.
                            </audio>
                        </div>
                    {% elif c_type == "image" or has_image %}
                        <a href="{% url 'content-representation' content.slug %}?type=image">
                            <img src="/{{ MEDIA_URL }}{{ base_src }}"
                                 {% if srcset %}srcset="{{ srcset }}"{% endif %}
                                 alt="{{ content.title }}"
                                 class="main-content-image" />
                        </a>
                    {% else %}
                        <div class="no-content">No representation available</div>
                    {% endif %}
                {% endwith %}
            </div>
        </section>
        <section class="info-section">
            <header class="content-header">
                <h1>{{ content.title|default:"Untitled" }}</h1>
            </header>
            <div class="download-buttons-wrapper info-section-element">
                <h3>Download</h3>
                <a class="button"
                   href="{% url 'content-representation' content.slug %}?clevel=1"
                   download>CL 1</a>
                <a class="button"
                   href="{% url 'content-representation' content.slug %}?clevel=2"
                   download>CL 2</a>
                <a class="button"
                   href="{% url 'content-representation' content.slug %}?clevel=3"
                   download>CL 3</a>
            </div>
            {% if content.description %}<div class="description">{{ content.description|markdown }}</div>{% endif %}
            <section class="origin-section info-section-element">
                <h3>Sources</h3>
                <ul class="origin-list">
                    {% for origin_item in content.origin_set.all %}
                        <li class="origin-item {% if origin_item.alternate %}alternate{% endif %}">
                            {% with origin_url=origin_item.get_url_if_possible %}
                                {% if origin_url %}
                                    <a href="{{ origin_url }}"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="origin-link">
                                        <strong>{{ origin_item.name }}</strong>: <code>{{ origin_item.origin_id }}</code>
                                    </a>
                                {% else %}
                                    <strong>{{ origin_item.name }}</strong>:
                                    {% if origin_item.origin_id %}
                                        <code>{{ origin_item.origin_id }}</code>
                                    {% else %}
                                        <em>No ID</em>
                                    {% endif %}
                                {% endif %}
                            {% endwith %}
                            {% if origin_item.alternate %}<span class="badge">Alternate</span>{% endif %}
                        </li>
                    {% empty %}
                        <li>No origin information available.</li>
                    {% endfor %}
                </ul>
            </section>
            <aside class="tags-sidebar info-section-element">
                <h3>Metadata</h3>
                {% for category_name, tags in grouped_tags.items %}
                    <div class="tag-group">
                        <h4 class="category-title">{{ category_name }}</h4>
                        <ul class="tag-list">
                            {% for tag_id, tag_title in tags %}
                                <li>
                                    <a href="/medialib/tag/id{{ tag_id }}" class="tag-link button">{{ tag_title }}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% empty %}
                    <p class="no-tags">No tags assigned.</p>
                {% endfor %}
            </aside>
            <footer class="technical-info">
                <code title="{{ content.source_hash.hex }}">SHA-256: {{ content.source_hash.hex }}</code>
                <code>Content ID: {{ content.id }}</code>
                <time datetime="{{ content.addition_date|date:'Y-m-d' }}">
                    Added: {{ content.addition_date|date:"d E Y" }}
                </time>
            </footer>
        </section>
    </article>
    {% if similar_content %}
        <section class="similar-content-section">
            <h3>Similar Images</h3>
            <div class="similar-grid">
                {% for item in similar_content %}
                    <a href="{% url 'content-info' item.slug %}" class="similar-item">
                        <img src="/{{ MEDIA_URL }}{{ item.base_src }}"
                             srcset="{{ item.srcset }}"
                             alt="{{ item.name }}"
                             loading="lazy"
                             class="similar-thumb">
                    </a>
                {% endfor %}
            </div>
        </section>
    {% endif %}
{% endblock %}
