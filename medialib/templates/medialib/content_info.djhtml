{% extends "medialib/base.djhtml" %}
{% load markdown_extras %}
{% block title %}{{ content.title|default:"Untitled" }} - MediaLib v2{% endblock %}
{% block content %}
    <style>
    .content-page {
        display: flex;
        flex-wrap: wrap;
        gap: 24px;
        padding: 20px;
        max-width: 1600px;
        margin: 0 auto;
    }

    .viewer-section {
        flex: 2 1 600px;
        display: flex;
        flex-direction: column;
        align-items: center;
        background-color: var(--bg-accent);
        border-radius: 12px;
        padding: 10px;
        border: 1px solid var(--border-color);
    }

    .media-container {
        width: 100%;
        display: flex;
        justify-content: center;
    }

    img.main-content-image, 
    video.main-content-video {
        max-width: 100%;
        max-height: 85vh;
        border-radius: 4px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }

    .info-section {
        flex: 1 1 350px;
        display: flex;
        flex-direction: column;
        gap: 20px;
        min-width: 0;
    }

    .content-header h1 {
        margin: 0 0 10px 0;
        font-size: 1.8rem;
        color: var(--accent-color);
        inline-size: 100%;
        overflow-wrap: break-word;
        word-break: break-all;
    }

    .description {
        line-height: 1.6;
        color: var(--text-main);
        background: var(--bg-accent);
        padding: 15px;
        border-radius: 8px;
        border-left: 4px solid var(--accent-color);
        overflow-wrap: anywhere;
        overflow-x: scroll;
    }

    .description img{
        max-width: 100%;
        height: auto;
        border-radius: 4px;
    }

    .description p {
        margin-bottom: 1em;
    }

    .description code {
        background: var(--bg-input);
        color: var(--text-input, var(--text-main));
        padding: 2px 4px;
        border-radius: 4px;
        font-family: monospace;
        overflow-x: scroll;
        max-width: 100%;
        display: block;
        background-color: var(--bg-header-item, var(--bg-input));
        padding: 1em;
        border: 1px solid var(--border-color);
    }
    
    .description ul, .description ol {
        padding-left: 1.5em;
        margin-bottom: 1em;
    }

    .info-section-element {
        background: var(--bg-accent);
        padding: 20px;
        border-radius: 8px;
        border: 1px solid var(--border-color);
    }

    .origin-section h2, .tags-sidebar h2 {
        margin-top: 0;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 10px;
        font-size: 1.2rem;
    }

    .origin-list, .tag-list {
        list-style: none;
        padding: 0;
        margin: 10px 0 0 0;
    }

    .origin-item {
        margin-bottom: 8px;
        font-size: 0.95rem;
    }

    .tag-group { margin-bottom: 15px; }
    .category-title { 
        font-size: 0.8rem; 
        text-transform: uppercase; 
        color: var(--text-muted);
        margin-bottom: 5px;
    }

    .technical-info {
        margin-top: auto;
        padding: 15px;
        font-size: 0.8rem;
        color: var(--text-muted);
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .technical-info code {
        display: block;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;
        cursor: help;
    }

    .similar-content-section {
        width: 100%;
        margin-top: 3rem;
        padding: 20px;
        border-top: 2px solid var(--border-color);
        box-sizing: border-box;
    }

    .similar-grid {
        display: flex;
        overflow-x: auto;
        gap: 16px;
        padding: 15px 5px;
        scrollbar-width: thin;
        scrollbar-color: var(--accent-color) transparent;
    }

    .similar-item {
        flex: 0 0 auto;
        width: 128px;
        height: 128px;
        border-radius: 8px;
        overflow: hidden;
        border: 2px solid transparent;
        transition: transform 0.2s, border-color 0.2s;
        display:flex;
        align-items: center;
        justify-content: center;
    }

    .similar-item:hover {
        border-color: var(--accent-color);
        transform: translateY(-5px);
    }

    #slug-clipboard-copy-btn {
        transition: background-color 1s, border-color 1s;
    }
    #slug-clipboard-copy-btn.highlight{
        border-color: var(--bg-main);
        background-color: var(--accent-color);
    }

    /*** Download form ***/

    .download-form {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-top: 10px;
    }

    .form-group {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }

    .form-group label {
        font-size: 0.9rem;
        color: var(--text-muted);
        white-space: nowrap;
    }

    .form-group select {
        flex: 1;
        padding: 6px 10px;
        border-radius: 4px;
        border: 1px solid var(--border-color);
        background-color: var(--bg-main);
        color: var(--text-main);
        font-size: 0.9rem;
        cursor: pointer;
        min-width: 150px;
    }

    .form-group select:focus {
        border-color: var(--accent-color);
        outline: none;
    }

    .download-submit-btn {
        width: 100%;
        margin-top: 4px;
        justify-content: center;
        display: flex;
        font-weight: bold;
    }

    /*** video-quality selectors ***/

    .quality-selector {
        border: none;
        padding: 0;
        margin: 10px 0;
        display: flex;
        gap: 8px;
        justify-content: center;
    }
    
    .sr-only { display: none; }
    
    .quality-option input[type="radio"] {
        display: none;
    }
    
    .quality-option label {
        display: inline-block;
        padding: 6px 12px;
        background-color: var(--bg-accent);
        color: var(--text-main);
        border: 1px solid var(--border-color);
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.9em;
        transition: all 0.2s ease;
        user-select: none;
    }
    
    .quality-option label:hover {
        border-color: var(--border-hover);
        background-color: var(--bg-wrapper);
    }
    
    .quality-option input[type="radio"]:checked + label {
        background-color: var(--accent-color);
        color: var(--text-on-accent);
        border-color: var(--accent-hover);
        font-weight: bold;
    }
    .quality-option input[type="radio"]:disabled + label {
        background-color: var(--bg-wrapper);
        color: var(--text-muted);
        border-color: var(--border-color);
        cursor: not-allowed;
        opacity: 0.6;
        text-decoration: line-through;
    }
    
    .quality-option input[type="radio"]:disabled + label:hover {
        background-color: var(--bg-wrapper);
        border-color: var(--border-color);
    }
    </style>
    <article class="content-page">
        <section class="viewer-section">
            <div class="media-container">
                {% with c_type=content.content_type %}
                    {% if video_representations %}
                        <video class="main-content-video"
                               id="main-video"
                               {% if c_type == "video-loop" %}autoplay loop muted playsinline{% else %}controls{% endif %}
                               poster="/{{ MEDIA_URL }}{{ base_src }}">
                            {% for repr in video_representations %}
                                {% if repr.compatibility_level <= CURRENT_CL %}
                                    <source src="/{{ MEDIA_URL }}{{ repr.filepath }}"
                                            type="{{ repr.get_mime_type }}; {{ repr.codec_string }}"
                                            data-clevel="{{ repr.compatibility_level }}" />
                                {% endif %}
                            {% endfor %}
                            Your browser does not support the video tag.
                        </video>
                    {% elif c_type == "audio" %}
                        <div class="audio-wrapper">
                            <audio controls src="/{{ MEDIA_URL }}{{ base_src }}">
                                Your browser does not support the audio element.
                            </audio>
                        </div>
                    {% elif c_type == "image" or has_image %}
                        <a href="{% url 'content-representation' content.slug %}?type=image">
                            <img src="/{{ MEDIA_URL }}{{ base_src }}"
                                 {% if srcset %}srcset="{{ srcset }}"{% endif %}
                                 alt="{{ content.title }}"
                                 class="main-content-image" />
                        </a>
                    {% else %}
                        <div class="no-content">No representation available</div>
                    {% endif %}
                {% endwith %}
            </div>
            {% if video_representations %}
                <div class="video-controls">
                    <fieldset id="cl-switcher" class="quality-selector">
                        <legend class="sr-only">Quality Level</legend>
                        {% for repr in video_representations %}
                            <div class="quality-option">
                                <input type="radio"
                                       name="cl-level"
                                       id="cl-{{ repr.compatibility_level }}"
                                       value="{{ repr.compatibility_level }}"
                                       {% if repr.compatibility_level > CURRENT_CL %}disabled{% endif %} />
                                <label for="cl-{{ repr.compatibility_level }}">CL{{ repr.compatibility_level }}</label>
                            </div>
                        {% endfor %}
                    </fieldset>
                </div>
            {% endif %}
        </section>
        <section class="info-section">
            <header class="content-header">
                <h1>{{ content.title|default:"Untitled" }}</h1>
            </header>
            <div class="download-buttons-wrapper info-section-element">
                <h2>Download</h2>
                <form action="{% url 'content-representation' content.slug %}"
                      method="get"
                      class="download-form">
                    <div class="form-group">
                        <label for="clevel">Compatibility level:</label>
                        <select name="clevel" id="clevel">
                            <option value="1" {% if request.session.clevel == 1 %}selected{% endif %}>CL 1</option>
                            <option value="2"
                                    {% if request.session.clevel == 2 or not request.session.clevel %}selected{% endif %}>
                                CL 2
                            </option>
                            <option value="3" {% if request.session.clevel == 3 %}selected{% endif %}>CL 3</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="filename_format">File name:</label>
                        <select name="filename_format" id="filename_format">
                            <option value="default" selected>Original name</option>
                            <option value="content_slug">Content slug</option>
                            <option value="title_slug">ID + Content Title</option>
                            <option value="origin_id">Origin Source ID</option>
                            <option value="random_string">Random string</option>
                            <option value="random_digits">Random digits</option>
                        </select>
                    </div>
                    <input type="hidden" name="download" value="1" />
                    <button type="submit" class="button download-submit-btn">Download</button>
                </form>
            </div>
            {% if content.description %}<div class="description">{{ content.description|markdown }}</div>{% endif %}
            <section class="origin-section info-section-element">
                <h2>Sources</h2>
                <ul class="origin-list">
                    {% for origin_item in content.origin_set.all %}
                        <li class="origin-item {% if origin_item.alternate %}alternate{% endif %}">
                            {% with origin_url=origin_item.get_url_if_possible %}
                                {% if origin_url %}
                                    <a href="{{ origin_url }}"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="origin-link">
                                        <strong>{{ origin_item.name }}</strong>: <code>{{ origin_item.origin_id }}</code>
                                    </a>
                                {% else %}
                                    <strong>{{ origin_item.name }}</strong>:
                                    {% if origin_item.origin_id %}
                                        <code>{{ origin_item.origin_id }}</code>
                                    {% else %}
                                        <em>No ID</em>
                                    {% endif %}
                                {% endif %}
                            {% endwith %}
                            {% if origin_item.alternate %}<span class="badge">Alternate</span>{% endif %}
                        </li>
                    {% empty %}
                        <li>No origin information available.</li>
                    {% endfor %}
                </ul>
            </section>
            {% if user.is_authenticated and user_collections %}
                <section class="info-section-element">
                    <h2>Add to Collection</h2>
                    <form action="{% url 'collection-add-item-direct' %}"
                          method="post"
                          style="display: flex;
                                 gap: 5px;
                                 flex-wrap: wrap">
                        {% csrf_token %}
                        <input type="hidden" name="content_id" value="{{ content.id }}">
                        <select name="collection_id"
                                class="button"
                                style="flex-grow: 1;
                                       text-align: left">
                            {% for col in user_collections %}<option value="{{ col.pk }}">{{ col.title }}</option>{% endfor %}
                        </select>
                        <button type="submit" class="button accent">Add</button>
                    </form>
                </section>
            {% endif %}
            <section class="tags-sidebar metadata-section info-section-element">
                <h2>Metadata</h2>
                {% for category_name, tags in grouped_tags.items %}
                    <div class="tag-group">
                        <h4 class="category-title">{{ category_name }}</h4>
                        <ul class="tag-list">
                            {% for tag_id, tag_title in tags %}
                                <li>
                                    <a href="/medialib/tag/id{{ tag_id }}" class="tag-link button">{{ tag_title }}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% empty %}
                    <p class="no-tags">No tags assigned.</p>
                {% endfor %}
                {% if plain_tags %}
                    <details>
                        <summary>Click for plain tags list</summary>
                        <p>{{ plain_tags }}</p>
                    </details>
                {% endif %}
            </section>
            {% if content.album_item.exists %}
                <section class="info-section-element">
                    <h2>In albums</h2>
                    <ul class="origin-list">
                        {% for album_item in content.album_item.all %}
                            <li class ="origin-item">
                                <a href="{% url 'album-detail' album_item.album.pk %}"
                                   class="origin-link">{{ album_item.album.get_album_name }}</a>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}
            <footer class="technical-info">
                <code title="{{ content.source_hash.hex }}">SHA-256: {{ content.source_hash.hex }}</code>
                <code>Content ID: {{ content.id }}</code>
                <div>
                    <button type="button"
                            data-content-slug="{{ content.slug }}"
                            id="slug-clipboard-copy-btn"
                            class="clipboard-copy">Copy content slug to clipboard</button>
                    <script>
                        const btn = document.getElementById("slug-clipboard-copy-btn");
                        function remove_highlight_from_button(button) {
                            const btn = document.getElementById("slug-clipboard-copy-btn");
                            btn.classList.remove("highlight");
                        }
                        btn.onclick = function(e){
                            const button = e.currentTarget;
                            const slug = button.dataset.contentSlug;
                            if (navigator.clipboard && navigator.clipboard.writeText){
                                navigator.clipboard.writeText(slug);
                                button.classList.add("highlight");
                                setTimeout(remove_highlight_from_button, 2000, button);
                            } else {
                                alert("Unable to copy to the clipboard")
                            }
                        }
                    </script>
                </div>
                <time datetime="{{ content.addition_date|date:'Y-m-d' }}">
                    Added: {{ content.addition_date|date:"d E Y" }}
                </time>
            </footer>
        </section>
    </article>
    {% if similar_content %}
        <section class="similar-content-section">
            <h2>Similar Images</h2>
            <div class="similar-grid">
                {% for item in similar_content %}
                    <a href="{% url 'content-info' item.slug %}" class="similar-item">
                        <img src="/{{ MEDIA_URL }}{{ item.base_src }}"
                             srcset="{{ item.srcset }}"
                             alt="{{ item.name }}"
                             loading="lazy"
                             class="similar-thumb">
                    </a>
                {% endfor %}
            </div>
        </section>
    {% endif %}
    <script>
    const sourcesMap = {};
    const urlToClMap = {};
    document.addEventListener('DOMContentLoaded', () => {
        const video = document.getElementById('main-video');
        const switcher = document.getElementById('cl-switcher');
        
        if (!video || !switcher) return;
    

        video.querySelectorAll('source').forEach(srcTag => {
            const cl = srcTag.getAttribute('data-clevel');
            sourcesMap[cl] = srcTag.getAttribute('src');
            const fullUrl = new URL(srcTag.getAttribute('src'), window.location.origin).href;
            urlToClMap[fullUrl] = cl;

        });
    
        switcher.addEventListener('change', (event) => {
            const selectedCL = event.target.value;
            const newSrc = sourcesMap[selectedCL];
    
            if (newSrc && video.src !== newSrc) {
                const currentTime = video.currentTime;
                const isPaused = video.paused;
    
                video.src = newSrc;
                
                video.load(); 
    
                video.onloadedmetadata = () => {
                    video.currentTime = currentTime;
                    if (!isPaused) video.play();
                    video.onloadedmetadata = null;
                };
            }
        });

        const updateActiveRadio = () => {
            const currentSrc = video.currentSrc;
            const currentCL = urlToClMap[currentSrc];

            if (currentCL) {
                const radio = document.querySelector(`.quality-option input[value="${currentCL}"]`);
                if (radio) radio.checked = true;
            }
        };

        video.addEventListener('loadedmetadata', updateActiveRadio);

        if (video.currentSrc) updateActiveRadio();
    });
    </script>
{% endblock %}
