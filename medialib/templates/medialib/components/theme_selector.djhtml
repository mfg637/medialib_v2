<section class="theme-selector-container">
    <label for="theme-selector">Theme:</label>
    <select id="theme-selector">
        <option value="NONE">Browser default</option>
        <option value="dark">Dark</option>
        <option value="dark-purple">Dark Purple</option>
        <option value="rarity">Rarity</option>
        <!--<option value="twilight-sparkle">Twilight Sparkle</option>
        <option value="aqua-rarity">Aqua Rarity</option>-->
    </select>
</section>
<script>
const ls_theme_key = "ml-theme";
(function() {
    const themeSelector = document.getElementById("theme-selector");
    let currentTheme = localStorage.getItem(ls_theme_key);

    if (currentTheme) {
        themeSelector.value = currentTheme;
    }else{
        themeSelector.value = "NONE";
    }

    themeSelector.onchange = function () {
        console.debug("ls_theme_key", ls_theme_key);
        let newTheme = this.value;
        
        if (currentTheme && currentTheme !== "NONE") {
            document.documentElement.classList.remove(currentTheme);
        }

        if (newTheme === "NONE") {
            localStorage.removeItem(ls_theme_key);
            currentTheme = null;
        } else {
            document.documentElement.classList.add(newTheme);
            localStorage.setItem(ls_theme_key, newTheme);
            currentTheme = newTheme;
        }
        console.info(`Theme changed to: ${newTheme}`);
    }
})();
</script>
